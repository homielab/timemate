<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%1$@ pomodoros, %2$@ min vs the previous 7 days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@ %3$#@pomodoros@, %2$@ min vs the previous 7 days</string>
		<key>pomodoros</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>pomodoro</string>
			<key>other</key>
			<string>pomodoros</string>
		</dict>
	</dict>
	<key>%1$@: %2$lld pomodoros, %3$lld minutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@: %2$#@pomodoros@, %3$#@minutes@</string>
		<key>minutes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld minute</string>
			<key>other</key>
			<string>%lld minutes</string>
		</dict>
		<key>pomodoros</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld pomodoro</string>
			<key>other</key>
			<string>%lld pomodoros</string>
		</dict>
	</dict>
	<key>Today: %lld pomodoros · %lld min</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Today: %1$#@pomodoros@ · %2$lld min</string>
		<key>pomodoros</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld pomodoro</string>
			<key>other</key>
			<string>%lld pomodoros</string>
		</dict>
	</dict>
	<key>Week: %lld pomodoros · %lld min</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Week: %1$#@pomodoros@ · %2$lld min</string>
		<key>pomodoros</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld pomodoro</string>
			<key>other</key>
			<string>%lld pomodoros</string>
		</dict>
	</dict>
</dict>
</plist>
